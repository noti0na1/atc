# Copy to .env (git-ignored) and configure the providers you use.
# start.sh and start.ps1 load literal values and never replace a non-empty exported value.

# LLM API keys. The provider SDKs read these directly, and a config can name them
# with "key": "${OPENAI_API_KEY}" or "keyEnv": "OPENAI_API_KEY". A checkout uses
# this file; an installed ATC reads .atc/keys.properties first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any other key your config references, for example "key": "${DEEPSEEK_API_KEY}"
#DEEPSEEK_API_KEY=

# Optional settings for start.sh and start.cmd
# Model alias to start with (a key of "models" in the config), same as -m
#ATC_MODEL=claude
# Extra config file merged over ~/.atc/config.json and ./.atc/config.json, same as -c
#ATC_CONFIG=
# Working directory for the agent (default: where you run the start script), same as -C
#ATC_CWD=
# JVM options for the agent process
#ATC_JAVA_OPTS=-Xmx2g
# Set to 1 to print stack traces of unexpected errors
#ATC_DEBUG=
# Set to 1 to draw the terminal layout with ASCII characters only
#ATC_ASCII=
# Read environment values from another file instead of ./.env
#ATC_ENV_FILE=
# Set to 1 to run an already-built out/dist.dest without checking source timestamps
#ATC_SKIP_BUILD=
# Set to 0 to start the JVM without the startup cache under out/dist.dest/startup
#ATC_STARTUP_CACHE=
