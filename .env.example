# Copy to .env (git-ignored) and fill in what you use. start.sh/start.cmd load
# this file without overriding variables that are already set in your shell.

# LLM API keys — the SDKs read these directly (or reference them from the
# config with "key": "${OPENAI_API_KEY}" / "keyEnv": "OPENAI_API_KEY").
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any other key your config references, e.g. "key": "${DEEPSEEK_API_KEY}"
#DEEPSEEK_API_KEY=

# Optional overrides for start.sh and start.cmd
# Model alias to start with (a key of "models" in the config), same as -m
#ATC_MODEL=claude
# Extra config file merged over ~/.atc/config.json and ./.atc/config.json, same as -c
#ATC_CONFIG=
# Working directory for the agent (default: where you run start.sh/start.cmd), same as -C
#ATC_CWD=
# JVM options for the agent process
#ATC_JAVA_OPTS=-Xmx2g
# Set to 1 to print stack traces of unexpected errors
#ATC_DEBUG=
# Set to 1 to draw the terminal layout with ASCII characters only
#ATC_ASCII=
# Read environment values from another file instead of ./.env
#ATC_ENV_FILE=
# Run an already-built out/dist.dest without checking source timestamps
#ATC_SKIP_BUILD=
