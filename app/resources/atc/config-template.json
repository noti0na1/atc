{
  "model": "claude",
  "classifiedModel": "local",
  "providers": {
    "anthropic": {
      "api": "anthropic",
      "models": {
        "claude":  { "name": "claude-opus-5",   "webSearch": true, "reasoning": "high" },
        "sonnet":  { "name": "claude-sonnet-5", "webSearch": true }
      }
    },
    "openai": {
      "api": "openai-responses",
      "models": {
        "gpt":  { "name": "gpt-5", "webSearch": true },
        "chat": { "name": "gpt-4.1" }
      }
    },
    "deepseek": {
      "api": "openai-responses",
      "url": "https://api.deepseek.com",
      "key": "${DEEPSEEK_API_KEY}",
      "models": {
        "deepseek": { "name": "deepseek-v4-flash", "reasoning": "high", "webSearch": true }
      }
    },
    "ollama": {
      "api": "openai",
      "url": "http://localhost:11434/v1",
      "key": "ollama",
      "models": { "local": { "name": "llama3.1" } }
    }
  },
  "files": [
    { "path": ".", "access": "write" },
    { "path": ".atc", "access": "none", "locked": true },
    { "path": "./build", "access": "read" },
    { "path": "secrets", "classified": true },
    { "path": "~/notes", "access": "read", "locked": true }
  ],
  "commands": ["git status", "git diff*", "git log*"],
  "denyCommands": ["git push*", "rm -rf *", "sudo *"],
  "hosts": ["*.scala-lang.org", "docs.oracle.com"],
  "denyHosts": ["*.internal"],
  "safeMode": true,
  "respectGitignore": true,
  "mode": "full",
  "executionTimeoutMs": 180000,
  "maxToolCalls": 60
}
