{
  "providers": {
    "anthropic": {
      "api": "anthropic",
      "key": "${ANTHROPIC_API_KEY}",
      "models": {
        "claude": { "name": "claude-opus-5",   "webSearch": true, "reasoning": "high", "contextWindow": "200k" },
        "sonnet": { "name": "claude-sonnet-5", "webSearch": true, "reasoning": "high", "contextWindow": "200k" }
      }
    },
    "openai": {
      "api": "openai-responses",
      "key": "${OPENAI_API_KEY}",
      "models": {
        "gpt":  { "name": "gpt-5",   "webSearch": true, "contextWindow": "400k" },
        "chat": { "name": "gpt-4.1", "contextWindow": "1m" }
      }
    },
    "deepseek": {
      "api": "openai-responses",
      "url": "https://api.deepseek.com",
      "key": "${DEEPSEEK_API_KEY}",
      "models": {
        "deepseek-flash": { "name": "deepseek-v4-flash", "reasoning": "max",  "webSearch": true, "contextWindow": "1m" },
        "deepseek-pro":   { "name": "deepseek-v4-pro",   "reasoning": "high", "webSearch": true, "contextWindow": "1m" }
      }
    },
    "openrouter": {
      "api": "openai",
      "url": "https://openrouter.ai/api/v1",
      "key": "${OPENROUTER_API_KEY}",
      "models": {}
    },
    "ollama": {
      "api": "openai",
      "url": "http://localhost:11434/v1",
      "key": "ollama",
      "models": { "local": { "name": "llama3.1", "contextWindow": "128k" } }
    }
  },

  "files": [
    { "path": ".atc", "access": "none", "locked": true },
    { "path": ".ssh",       "classified": true },
    { "path": ".gnupg",     "classified": true },
    { "path": ".env",       "classified": true },
    { "path": ".env.*",     "classified": true },
    { "path": ".netrc",     "classified": true },
    { "path": ".npmrc",     "classified": true },
    { "path": ".pypirc",    "classified": true },
    { "path": ".docker",    "classified": true },
    { "path": ".kube",      "classified": true },
    { "path": ".aws",       "classified": true },
    { "path": ".azure",     "classified": true },
    { "path": ".gcloud",    "classified": true },
    { "path": "*.pem",      "classified": true },
    { "path": "id_rsa",     "classified": true },
    { "path": "id_ed25519", "classified": true }
  ],

  "commands": [],
  "denyCommands": ["rm -rf *", "sudo *"],

  "mode": "full",
  "safeMode": true,
  "respectGitignore": true,
  "executionTimeoutMs": 180000,
  "maxToolCalls": 60,
  "maxToolOutputChars": 40000
}
