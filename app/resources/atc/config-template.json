{
  "providers": {},

  "files": [
    { "path": ".atc", "access": "none", "locked": true },
    { "path": ".ssh",       "classified": true },
    { "path": ".gnupg",     "classified": true },
    { "path": ".env",       "classified": true },
    { "path": ".env.*",     "classified": true },
    { "path": ".netrc",     "classified": true },
    { "path": ".npmrc",     "classified": true },
    { "path": ".pypirc",    "classified": true },
    { "path": ".docker",    "classified": true },
    { "path": ".kube",      "classified": true },
    { "path": ".aws",       "classified": true },
    { "path": ".azure",     "classified": true },
    { "path": ".gcloud",    "classified": true },
    { "path": "*.pem",      "classified": true },
    { "path": "id_rsa",     "classified": true },
    { "path": "id_ed25519", "classified": true }
  ],

  "commands": [],
  "denyCommands": [
    "rm -rf *", "sudo",
    "sh", "bash", "dash", "ash", "ksh", "ksh93", "mksh", "zsh", "csh", "tcsh", "fish",
    "cmd", "powershell", "pwsh", "wsl", "git-bash"
  ],

  "mode": "full",
  "safeMode": true,
  "respectGitignore": true,
  "executionTimeoutMs": 300000,
  "maxToolCalls": 200,
  "maxToolOutputChars": 40000,
  "autoCompactThreshold": 0.8,
  "compactKeepRatio": 0.2
}
