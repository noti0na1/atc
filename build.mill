//| mill-version: 1.1.8
package build

import mill.*, scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

object Versions:
  val atc = "0.1.1"
  val scala = "3.10.0-RC1-bin-20260816-3adfcbd-NIGHTLY"
  val jline = "4.3.1"
  val upickle = "4.4.3"
  val openai = "4.52.0"
  val anthropic = "2.54.0"
  val munit = "1.3.5"

val scalaNightlies = "https://repo.scala-lang.org/artifactory/maven-nightlies/"

/** Shared settings; `ScalafmtModule` gives `./mill __.reformat` and `./mill __.checkFormat` (see `.scalafmt.conf`). */
trait AtcScalaModule extends ScalaModule, ScalafmtModule:
  def scalaVersion = Versions.scala
  def repositories = Seq(scalaNightlies)
  def scalacOptions = Seq(
    "-deprecation", "-feature", "-unchecked",
    "-release:17",
    "-language:experimental.modularity",
  )
  trait AtcTests extends ScalaTests, TestModule.Munit, ScalafmtModule:
    def mvnDeps = Seq(mvn"org.scalameta::munit:${Versions.munit}")

/** The capability-safe API visible to agent code (`atc.lib.Interface`).
  * Compiled with capture checking; every agent-facing definition is
  * `@assumeSafe`. The app implements the interface; the sandbox shares these
  * classes with the app through a filtering class loader. */
object lib extends AtcScalaModule:
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-language:experimental.captureChecking",
    "-Yexplicit-nulls",
    "-Wsafe-init",
  )
  /** The agent-facing API source; the app bundles it for the system prompt. */
  def interfaceSource = Task.Source("src/atc/lib/Interface.scala")
  object test extends AtcTests

/** The agent application: TUI, LLM providers, permission policy, sandbox host. */
object app extends AtcScalaModule:
  def moduleDeps = Seq(lib)
  def scalacOptions = super.scalacOptions() ++ Seq("-Yexplicit-nulls")
  def mainClass = Some("atc.Main")
  def mvnDeps = Seq(
    mvn"org.scala-lang::scala3-compiler:${Versions.scala}",
    mvn"org.scala-lang::scala3-repl:${Versions.scala}",
    mvn"org.jline:jline-prompt:${Versions.jline}",
    mvn"org.jline:jline-terminal-jni:${Versions.jline}",
    mvn"com.lihaoyi::upickle:${Versions.upickle}",
    mvn"com.openai:openai-java:${Versions.openai}",
    mvn"com.anthropic:anthropic-java:${Versions.anthropic}",
  )
  /** The REPL compiler needs the library and the Scala stdlib as jars/dirs on
    * its `-classpath` (the same artifacts the app runs with). */
  def libClasspathArg = Task {
    val cp = lib.runClasspath().map(_.path).filter(os.exists(_)).map(_.toString).mkString(java.io.File.pathSeparator)
    s"-Datc.lib.classpath=$cp"
  }
  /** Bundle the agent-facing API source (for the system prompt) and the version
    * (for the banner and `--version`). The `--init` config template lives in
    * `app/resources/atc/config-template.json`. */
  def resources = Task {
    os.copy(lib.interfaceSource().path, Task.dest / "atc" / "Interface.scala.txt", createFolders = true)
    os.write(Task.dest / "atc" / "version.txt", Versions.atc)
    super.resources() ++ Seq(PathRef(Task.dest))
  }
  def forkArgs = Task { Seq(libClasspathArg(), "-Dfile.encoding=UTF-8") }
  object test extends AtcTests:
    def forkArgs = Task { Seq(app.libClasspathArg()) }

/** Build a self-contained distribution under `out/dist.dest/`. */
def dist = Task {
  val libJar = lib.assembly().path
  val appJar = app.assembly().path
  os.copy(libJar, Task.dest / "atc-lib.jar", replaceExisting = true)
  os.copy(appJar, Task.dest / "atc.jar", replaceExisting = true)
  val script =
    s"""#!/usr/bin/env sh
       |DIR=$$(cd "$$(dirname "$$0")" && pwd)
       |exec java -Datc.lib.classpath="$$DIR/atc-lib.jar" -jar "$$DIR/atc.jar" "$$@"
       |""".stripMargin
  os.write.over(Task.dest / "atc", script, perms = "rwxr-xr-x")
  PathRef(Task.dest)
}
